# Neon PostgreSQL
# Dashboard → Connect → copy strings.
# DATABASE_URL = pooled (host contains -pooler)
# DIRECT_URL   = direct (no -pooler), used by prisma migrate
# If you only have one string, paste it into both.

DATABASE_URL=
DIRECT_URL=

NODE_ENV=production

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000

# Frontend origins allowed for API calls. Comma-separated list, or * for local dev.
# Example: https://shop.example.com,http://localhost:5173
CORS_ORIGIN=
UPLOAD_DIR=./uploads
